# Optional: leave DATABASE_URL unset to run without Postgres — the API then
# serves retrieval from data/case_store.json and stores briefs in data/briefs/.
# Set it to use Postgres + pgvector instead (docker compose up -d postgres):
# DATABASE_URL=postgresql://sd_user:sd_password@localhost:5432/success_directory

# Free cloud defaults
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding provider: voyage, jina, or openai
# Jina's default model returns 1024 dimensions, matching the current schema.
EMBEDDING_PROVIDER=jina
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_TASK=text-matching

# Optional paid/fallback providers
# To use Anthropic, set ANTHROPIC_API_KEY in your local .env.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# To use Voyage, set VOYAGE_API_KEY in your local .env.
# To use OpenAI embeddings, set OPENAI_API_KEY in your local .env.
# EMBEDDING_PROVIDER=openai

# ─── Deployment ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. '*' is ignored: callers may
# send their own API keys on these requests, so the origin must be explicit.
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app

# Leaving LLM_PROVIDER / its key unset enables bring-your-own-key only mode:
# visitors supply their own provider + key and the model calls run on their
# quota rather than yours. An embedding key (JINA_API_KEY) is still required.
